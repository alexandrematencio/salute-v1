# ─── TinaCMS Cloud ──────────────────────────────────────────────────────────
# Créer un compte sur https://app.tina.io et un nouveau projet, puis copier
# les valeurs ci-dessous depuis le dashboard.
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
# Optionnel : branche Git pour le contenu (par défaut : main)
# GITHUB_BRANCH=main

# ─── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://salute-villejuif.fr

# ─── Email (formulaires contact/devis) ──────────────────────────────────────
# À choisir : Resend (recommandé pour Next.js) ou Postmark
# RESEND_API_KEY=

# ─── Analytics ──────────────────────────────────────────────────────────────
# Recommandation : Vercel Web Analytics (zéro config, GDPR-friendly par défaut)
# ou Matomo / Plausible self-hosted (exemptés de consentement par la CNIL).
# Éviter GA4 sauf nécessité — soumis à consentement et complique la conformité.

# ─── Vercel ─────────────────────────────────────────────────────────────────
# Auto-injecté par la plateforme : VERCEL_GIT_COMMIT_REF, VERCEL_URL, etc.
